
import groovy.transform.Field

@Library('jenkins-sharedlibs')_

Field projectSettings = 'ci/project.settings'
Field podYaml = 'ci/jenkins-pipeline.yaml'

pipeline {
    agent

    environment {
        GIT_LFS_SKIP_SMUDGE=1
        DEBUG = 0
    }

    options {
        buildDiscarder(logRotator(numToKeepStr: '5', daysToKeepStr: '10'))
        timestamps()
        ansiColor('xterm')
    }

    stages {
         stage('Generate yaml for Build') {
            steps {
                updateDependentFiles(projectSettings)
                archiveArtifacts artifacts: podYaml, fingerprint: true
            }
         }
         stage('Build Branch') {
             steps {
                 script {
                     // Use the Kubernetes plugin to create a pod from the generated YAML
                     def podYAML = readFile(podYaml)
                     podTemplate(yaml: podYAML) {
                         node(POD_LABEL) {
                             // Run build in 'build' container
                             container(name: 'kaniko', shell: '/busybox/sh') {
                                 sh 'ci/kaniko.sh'
                             }
                         }
                     }
                 }
            }
        }
    }
    post {
        always {
            projectReporter('finished', script: this)
        }
    }
}
